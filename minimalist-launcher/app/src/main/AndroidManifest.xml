<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Needed to list every launchable app in the drawer and blocker pickers.
         Acceptable for a sideloaded personal launcher. -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- Granted by the user through Settings > Special app access > Usage access. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Home-screen temperature: one fetch to open-meteo.com using a coarse
         last-known location. Nothing else ever leaves the device. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Optional: instant block overlay; core blocking works without it. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Inert unless granted via adb; enables the system-wide grayscale toggle. -->
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <application
        android:name=".App"
        android:label="@string/app_name"
        android:icon="@drawable/ic_launcher"
        android:theme="@style/Theme.MiniLauncher"
        android:allowBackup="true"
        android:supportsRtl="true">

        <!--
            Declaration mirrors AOSP's Launcher3. Two things matter for the
            task switcher: NOT excludeFromRecents (the system already keeps the
            current home task out of the overview), and configChanges wide
            enough that a resize during the swipe-up animation re-lays out the
            window instead of destroying and recreating the activity, which
            makes the system cancel the recents animation. uiMode, density and
            fontScale are deliberately absent: theme and text sizes are
            resolved when the layout is inflated, so those must still recreate.
        -->
        <activity
            android:name=".ui.home.HomeActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:configChanges="keyboard|keyboardHidden|mcc|mnc|navigation|orientation|screenSize|screenLayout|smallestScreenSize">
            <!-- Home only: a launcher is not also a regular app entry. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.blocked.BlockedActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:launchMode="singleInstance" />

        <activity
            android:name=".ui.pause.PauseActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:launchMode="singleInstance" />

        <activity android:name=".ui.drawer.AppDrawerActivity" android:exported="false" />
        <activity android:name=".ui.stats.StatsActivity" android:exported="false" />
        <activity android:name=".ui.diagnostics.DiagnosticsActivity" android:exported="false" />
        <activity android:name=".ui.settings.SettingsActivity" android:exported="false" />
        <activity android:name=".ui.settings.ScheduleEditorActivity" android:exported="false" />
        <activity android:name=".ui.onboarding.OnboardingActivity" android:exported="false" />

        <service
            android:name=".blocking.AppBlockerAccessibilityService"
            android:exported="false"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <service
            android:name=".notifications.NotificationFilterService"
            android:exported="false"
            android:label="@string/notification_filter_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
